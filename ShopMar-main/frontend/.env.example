# Modo demo: la aplicación funciona sin backend.
#
# Todos los datos (ventas, clientes, gastos, pagos y el resumen) son de mentira y
# viven en memoria. Se reinician al refrescar la página, que es justo lo que
# necesita esta demo. No hace falta levantar ningún servidor: alcanza con
# `pnpm dev` en la raíz o `pnpm dev` dentro de `frontend/`.
PUBLIC_USE_MOCK=true

# Para conectar una API real, apagá el modo demo y definí la URL base. El prefijo
# `/api/v1` va DENTRO de esta variable, no en cada llamada.
# PUBLIC_USE_MOCK=false
# PUBLIC_API_URL=http://localhost:3000/api/v1
