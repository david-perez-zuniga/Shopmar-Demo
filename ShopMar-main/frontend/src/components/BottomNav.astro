---
import { Plus } from "lucide-astro"
import { bottomNavLinks } from "../lib/shell/nav-active"

interface NavLink {
  id: string
  label: string
  href: string
  // Componente de `lucide-astro`; el mismo que pinta la barra lateral.
  icon: any
}

interface Props {
  links: readonly NavLink[]
  activeSection?: "sales" | "packages" | "expenses" | "summary" | "customers"
}

const { links: allLinks, activeSection } = Astro.props

// S17: Clientes no va en la barra inferior. Se filtra el arreglo compartido
// —la lateral, la superior y el cajón lo siguen recibiendo entero— en vez de
// mantener acá una segunda lista de destinos.
const links = bottomNavLinks(allLinks)
---

<!--
  Barra de navegación inferior de móvil. Es parte del armazón: recibe los
  mismos enlaces que la barra lateral, filtra Clientes (S17) y vive fuera del
  contenido que el router reemplaza —como la barra lateral, la superior y el
  cajón—, así que ninguna navegación la remonta. No reemplaza a ninguno: solo
  aparece por debajo de 768px.
-->
<nav
  class="bottom-nav no-print"
  aria-label="Navegación inferior"
>
  <ul class="bottom-nav-list">
    {
      links.map((link, index) => {
        const isActive = activeSection === link.id
        const Icon = link.icon
        return (
          <>
            <li class="bottom-nav-item">
              <a
                href={link.href}
                class:list={["bottom-nav-link", { "bottom-nav-link--active": isActive }]}
                aria-current={isActive ? "page" : undefined}
                data-astro-prefetch
              >
                <Icon class="bottom-nav-icon" aria-hidden="true" />
                <span class="bottom-nav-label">{link.label}</span>
              </a>
            </li>
            {/*
              Botón de acción después de Ventas. No es un destino: no lleva
              `bottom-nav-link`, así que `nav-active.ts` lo ignora y nunca se
              marca como activo. La barra es una rejilla de cinco columnas
              (cuatro destinos más esta) con el círculo en su columna.
            */}
            {index === 1 && (
              <li class="bottom-nav-item bottom-nav-item--action">
                <a
                  href="/new"
                  class="bottom-nav-action"
                  aria-label="Registrar venta o gasto"
                  data-astro-prefetch
                >
                  <Plus class="bottom-nav-action-icon" stroke-width={2.4} aria-hidden="true" />
                </a>
              </li>
            )}
          </>
        )
      })
    }
  </ul>
</nav>

<style>
  .bottom-nav {
    position: fixed;
    inset-block-end: 0;
    inset-inline: 0;
    z-index: 40;
    display: none;
    background: var(--m3-surface-container-lowest);
    border-block-start: 1px solid var(--line);
    padding-inline-start: var(--safe-left);
    padding-inline-end: var(--safe-right);
  }

  /* Mismo corte que el resto del armazón móvil: por debajo de 768px. */
  @media (max-width: 767px) {
    .bottom-nav {
      display: block;
    }
  }

  .bottom-nav-list {
    display: grid;
    /* Los cuatro destinos más la columna del botón, entre Ventas y el resto. */
    grid-template-columns: repeat(5, minmax(0, 1fr));
    list-style: none;
    margin: 0;
    margin-inline: auto;
    padding: 0;
    max-width: var(--m3-container);
  }

  /*
    La columna del botón no lleva un enlace de destino, solo el círculo
    absoluto, así que aporta ancho pero no alto: los cuatro enlaces siguen
    fijando el alto de la fila.
  */
  .bottom-nav-item--action {
    position: relative;
  }

  .bottom-nav-action {
    position: absolute;
    inset-block-start: -18px;
    inset-inline-start: 50%;
    transform: translateX(-50%);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    inline-size: 60px;
    block-size: 60px;
    /*
      Anillo fino del color de la barra: separa el círculo del borde de la
      barra sin recortarlo. Antes medía 4px y el mismo color que la superficie,
      así que el círculo se leía como un hueco perforado en la barra. Nunca un
      hex: el token sigue el tema.
    */
    border: 2px solid var(--m3-surface-container-lowest);
    border-radius: 50%;
    background: var(--m3-primary);
    color: var(--m3-on-primary);
    /*
      `--shadow-overlay` es la única sombra del sistema y está reservada a los
      overlays: un botón que flota sobre la barra es exactamente ese caso. Es lo
      que separa el círculo de la barra y lo hace leer como botón, no como
      agujero.
    */
    box-shadow: var(--shadow-overlay);
    text-decoration: none;
    transition:
      background-color var(--dur-fast) var(--ease-out),
      box-shadow var(--dur-fast) var(--ease-out),
      transform var(--dur-fast) var(--ease-out);
  }

  .bottom-nav-action:hover {
    background: color-mix(in srgb, var(--m3-primary) 90%, var(--m3-on-primary));
  }

  /* Respuesta al toque: el botón baja y se apoya, con la misma curva del
     archivo. En táctil `:hover` no existe, así que este es el único acuse. */
  .bottom-nav-action:active {
    transform: translate(-50%, 2px);
    box-shadow: none;
  }

  .bottom-nav-action:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .bottom-nav-action-icon {
    flex: none;
    inline-size: 26px;
    block-size: 26px;
  }

  .bottom-nav-link {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2px;
    min-inline-size: 0;
    min-block-size: var(--touch-min);
    /* Con cinco columnas cada destino gana ancho respecto de la rejilla de
       seis, así que el relleno apretado de 2px de antes ya no hace falta: la
       etiqueta más larga («Paquetes») entra a 320px sin recortarse ni partirse. */
    padding: 10px var(--m3-space-xs);
    border-radius: var(--radius-md);
    color: var(--m3-on-surface-variant);
    font-size: var(--m3-fs-label-xs);
    line-height: var(--m3-lh-label-xs);
    text-align: center;
    text-decoration: none;
    transition:
      color var(--dur-base) var(--ease-out),
      background-color var(--dur-base) var(--ease-out);
  }

  .bottom-nav-link:hover {
    background: var(--surface-sunken);
    color: var(--m3-on-surface);
  }

  /* El destino activo se rellena, igual que la píldora de la barra lateral. */
  .bottom-nav-link--active {
    background: var(--surface-inset);
    color: var(--m3-primary);
    font-weight: var(--weight-bold);
  }

  .bottom-nav-link:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .bottom-nav-label {
    max-inline-size: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .bottom-nav-icon {
    flex: none;
    inline-size: 20px;
    block-size: 20px;
  }
</style>
