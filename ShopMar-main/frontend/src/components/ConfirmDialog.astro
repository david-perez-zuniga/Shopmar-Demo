---
interface Props {
  title?: string
  message: string
  actionLabel?: string
}

const { title = "¿Confirmar acción?", message, actionLabel = "Confirmar" } = Astro.props
---

<dialog
  class="confirm-dialog"
  aria-labelledby="confirm-title"
  aria-describedby="confirm-message"
>
  <div class="confirm-body">
    <h3 class="confirm-title" id="confirm-title">{title}</h3>
    <p class="confirm-message" id="confirm-message">{message}</p>
    <form method="dialog" class="confirm-actions">
      <button type="button" value="cancel" class="btn btn-secondary">
        Cancelar
      </button>
      <button type="submit" value="confirm" class="btn btn-primary">
        {actionLabel}
      </button>
    </form>
  </div>
</dialog>

<script>
  import { onReady } from "../lib/core/ready"
  import { wireConfirmDialog } from "../lib/core/confirm-dialog"

  // En las pantallas que todavía no son vistas de la SPA el diálogo ya está en
  // el documento: se cablea una vez. En la SPA lo cablea la vista al montar,
  // porque el diálogo llega dentro de una plantilla.
  onReady(() => {
    wireConfirmDialog()
  })
</script>

<style>
  /*
    S20 y S21: el diálogo es una hoja de pantalla completa anclada al borde
    derecho, igual que los de ventas y clientes. La entrada deslizante, el
    `100dvh` y el anclaje viven en `global.css` porque son la regla del sistema
    para todos los modales; acá queda lo propio del componente: su ancho, su
    borde de costura y el pie fijo.
  */
  .confirm-dialog {
    width: min(100%, 26rem);
    max-width: 26rem;
    padding: 0;
    border: 1px solid var(--border-strong);
    border-block: 0;
    border-inline-end: 0;
    border-radius: 0;
    background: var(--bg-elevated);
    color: var(--text-primary);
    box-shadow: var(--shadow-confirm);
  }

  .confirm-dialog::backdrop {
    background: rgba(17, 17, 17, 0.32);
  }

  .confirm-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    min-block-size: 100%;
    padding: var(--space-5);
  }

  .confirm-title {
    font-size: var(--text-h3);
    letter-spacing: var(--tracking-tight);
  }

  .confirm-message {
    font-size: var(--text-sm);
    color: var(--text-muted);
  }

  /* El pie queda fijo abajo: la hoja mide toda la pantalla y el mensaje puede
     crecer, pero los dos botones se alcanzan siempre. */
  .confirm-actions {
    position: sticky;
    inset-block-end: 0;
    display: flex;
    justify-content: flex-end;
    gap: var(--space-3);
    margin-block-start: auto;
    padding-block-start: var(--space-3);
    background: var(--bg-elevated);
  }
</style>