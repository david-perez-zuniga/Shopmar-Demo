---
import { DATE_PRESETS, presetFor } from "../lib/lists/date-presets"

/**
 * El filtro de fechas de las cuatro pantallas (S34).
 *
 * Tiene dos variantes porque el control tiene dos dueños distintos. En el resumen
 * el componente **es** el `<form>` (`variant="form"`), igual que antes. En ventas,
 * paquetes y gastos se incrusta dentro del `filter-row` que ya existe
 * (`variant="fields"`), para que el envío conserve canal, estado, condición,
 * vencidas, método y tamaño de página sin agregar un segundo formulario al lado.
 *
 * El marcado solo pinta: las opciones, los rangos y la lectura de la URL viven en
 * `src/lib/lists/date-presets.ts`, y el cableado en `src/lib/lists/filter-controls.ts`
 * (`hydrateDatePresets` / `wireDatePresets`), como el resto de los filtros.
 */
interface Props {
  /** `form`: el componente es el `<form>` (resumen). `fields`: se incrusta en un form ajeno. */
  variant?: "form" | "fields"
  /** URL del `GET` en la variante `form`; incrustado, el destino lo pone el `filter-row`. */
  action?: string
  /** Valor inicial del primer campo, en `YYYY-MM-DD`. Solo aplica al prerenderizar. */
  initialStart?: string
  /** Valor inicial del segundo campo, en `YYYY-MM-DD`. */
  initialEnd?: string
}

const {
  variant = "form",
  action = "",
  initialStart = "",
  initialEnd = "",
} = Astro.props

const isEmbedded = variant === "fields"

// El HTML se prerenderiza sin query string y sin `Date`: acá solo se decide el
// estado «sin rango» (Personalizado con los campos vacíos, S35). El rango real de
// la URL lo marca `hydrateDatePresets` en el cliente.
const preset = presetFor(initialStart, initialEnd)

const Tag = isEmbedded ? "div" : "form"
const fieldClass = isEmbedded ? "field field--date" : "date-field"
const inputClass = isEmbedded ? "field-input" : "input"
const startLabel = isEmbedded ? "Fecha desde" : "Desde"
const endLabel = isEmbedded ? "Fecha hasta" : "Hasta"
---

<Tag
  method={isEmbedded ? undefined : "get"}
  action={isEmbedded ? undefined : action}
  class:list={["date-filter", { "date-filter--embedded": isEmbedded }]}
>
  <!--
    Un `<select>` nativo (S36): el teclado, el lector de pantalla y el aspecto del
    desplegable vienen del sistema. El nombre `preset` nunca llega a la URL
    (`data-query-ignore`): el preset es una lectura del rango, no un segundo
    parámetro de filtro.
  -->
  <label class="date-preset-select">
    <span class="date-preset-caption">Período</span>
    <select class={inputClass} name="preset" data-preset data-query-ignore>
      {
        DATE_PRESETS.map((option) => (
          <option value={option.id} selected={option.id === preset}>
            {option.label}
          </option>
        ))
      }
    </select>
  </label>

  <!--
    Los dos campos solo se ven cuando el rango es «Personalizado»: con un preset
    el rango lo calcula el módulo y no hay nada que escribir. Igual llevan las
    fechas, porque son los que viajan en el envío del form.
  -->
  <div class="date-fields" data-date-fields hidden={preset !== "custom"}>
    <label class={fieldClass}>
      <span class={isEmbedded ? "field-label" : undefined}>{startLabel}</span>
      <input class={inputClass} type="date" name="start_date" value={initialStart} />
    </label>
    <label class={fieldClass}>
      <span class={isEmbedded ? "field-label" : undefined}>{endLabel}</span>
      <input class={inputClass} type="date" name="end_date" value={initialEnd} />
    </label>
  </div>

  <slot />

</Tag>

<style>
  .date-filter {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: var(--space-3);
  }

  /* Incrustado en la fila de una tabla: participa del flex de `.filter-fields` y
     toma su ancho del contenido, para que los selects sigan a la derecha. */
  .date-filter--embedded {
    width: auto;
    flex: 0 1 auto;
    min-width: 0;
    gap: var(--m3-space-md);
  }

  .date-presets {
    display: flex;
    flex-wrap: nowrap;
    gap: 2px;
  }

  .date-preset {
    position: relative;
    display: inline-flex;
    flex: 0 0 auto;
    min-width: 0;
  }

  /* El radio se oculta del dibujo pero no del foco ni del teclado. */
  .date-preset-input {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: 0;
    opacity: 0;
    pointer-events: none;
  }

  .date-preset-label {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 2.25rem;
    padding-inline: var(--m3-space-sm);
    background: var(--surface-inset);
    color: var(--ink-3);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    font-size: var(--m3-fs-label-md);
    line-height: var(--m3-lh-label-md);
    font-weight: 500;
    white-space: nowrap;
    cursor: pointer;
    transition:
      background-color var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out);
  }

  .date-preset:hover .date-preset-label {
    color: var(--ink);
    border-color: var(--ink-3);
  }

  /* La opción activa no se distingue solo por el color: se rellena, engorda la
     tipografía y suma un anillo interior claro, así que también se lee en escala
     de grises y con daltonismo. */
  .date-preset-input:checked + .date-preset-label {
    background: var(--ink);
    color: var(--bg);
    border-color: var(--ink);
    font-weight: 600;
    box-shadow: inset 0 0 0 2px var(--bg);
  }

  .date-preset-input:focus-visible + .date-preset-label {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .date-fields {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: var(--space-3);
  }

  .date-filter--embedded .date-fields {
    gap: var(--m3-space-md);
  }

  .date-field {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .date-field span {
    font-size: var(--text-label);
    font-weight: var(--weight-semibold);
    color: var(--text-muted);
  }

  .date-field .input {
    width: auto;
  }

  /* En móvil las tres opciones tienen que entrar en una sola fila y las fechas
     del rango personalizado caer debajo, sin scroll horizontal. El rótulo más
     largo es «Últimos 7 días», y `clamp` lo achica lo justo a 320px. */
  @media (max-width: 767px) {
    .date-filter--embedded {
      flex: 1 1 100%;
    }

    .date-presets {
      flex: 1 1 100%;
    }

    .date-preset {
      flex: 1 1 0;
    }

    .date-preset-label {
      padding-inline: var(--m3-space-xs);
      font-size: clamp(11px, 3.4vw, 13px);
    }

    .date-fields {
      flex: 1 1 100%;
    }
  }
</style>
