<script>
  import { initNavDrawer } from "../lib/shell/nav-drawer";
  import { initThemeToggle } from "../lib/shell/theme-toggle";
  import { initInstallPrompt } from "../lib/shell/install-prompt";
  import { initSessionNav } from "../lib/auth/session-ui";
  import { activeSectionFor, markActiveNav } from "../lib/shell/nav-active";
  import { onReady } from "../lib/core/ready";

  // El armazón vive lo que vive el documento: cajón, tema, instalación y sesión
  // se inicializan una vez. El enlace activo lo vuelve a marcar el router en cada
  // navegación, con `markActiveNav`.
  onReady(() => {
    for (const init of [initNavDrawer, initThemeToggle, initInstallPrompt, initSessionNav]) init()
    markActiveNav(activeSectionFor(window.location.pathname))
  })
</script>
