---
import DateRangeFilter from "../DateRangeFilter.astro"
import StatCard from "../StatCard.astro"
import { LayoutDashboard } from "lucide-astro"
import { SUMMARY_FIELDS } from "../../lib/summary/summary"
import "./summary.css"
---

  <div class="summary-page" data-page="summary">
    <!-- El filtro de fechas vive en el encabezado, arriba a la derecha (S37):
         los KPI van inmediatamente debajo, sin una fila de filtro intermedia. -->
    <div class="page-head">
      <div>
        <h1 class="page-title">
          <LayoutDashboard class="page-title-icon" aria-hidden="true" size={24} />
          Resumen
        </h1>
        <p class="summary-range" data-range-label hidden></p>
      </div>
      <div class="page-head-filter">
        <DateRangeFilter variant="form" action="/" />
      </div>
    </div>

    <!-- Las seis tarjetas del resumen (S15): devengado, conteo, gastos, caja y
         cartera. La lista vive en `lib/summary/summary.ts` para que el rótulo,
         la definición y la cifra de cada tarjeta sean una sola copia. -->
    <!-- Esqueleto de carga (S2): la cifra de cada tarjeta arranca como bloque y
         la reemplaza el valor cuando responde la API. Lo pinta el script de la
         vista porque `StatCard` es un componente compartido y no recibe markup;
         la estructura de la tarjeta —rótulo, definición, tono— es la de siempre. -->
    <div class="stat-grid" data-stat-grid aria-busy="true">
      {
        SUMMARY_FIELDS.map((card) => (
          <StatCard
            id={card.id}
            label={card.label}
            value="—"
            hint={card.hint}
            icon={card.icon}
            tone={card.tone}
          />
        ))
      }
    </div>

    <div class="summary-notice" data-empty hidden>
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="32"
        height="32"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M3 3v5h5"></path><path d="M3.05 13A9 9 0 1 0 6 5.3L3 8"></path>
        <path d="M12 7v5l4 2"></path>
      </svg>
      <p>Sin datos en el rango seleccionado</p>
    </div>

    <div class="summary-notice summary-notice--error" data-error hidden>
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="32"
        height="32"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <circle cx="12" cy="12" r="10"></circle><path d="M12 8v4"></path><path d="M12 16h.01"></path>
      </svg>
      <p class="summary-notice-text" data-error-text>Algo salió mal en el servidor.</p>
      <button type="button" class="btn btn-secondary" data-retry>Reintentar</button>
    </div>

    <section class="charts-row charts-row--daily" aria-labelledby="chart-daily-title">
      <div class="chart-card">
        <div class="chart-card__header">
          <div>
            <h2 id="chart-daily-title" class="chart-card__title" data-chart-daily-title>Ingresos y Gastos Diarios (C$)</h2>
            <p class="chart-card__subtitle" data-chart-daily-subtitle>Comparativo de flujo monetario en el período</p>
          </div>
          <label class="chart-view" for="chart-daily-mode">
            <span class="chart-view__label">Vista</span>
            <select class="chart-view__select" id="chart-daily-mode" data-chart-mode>
              <option value="income">Ingresos</option>
              <option value="expense">Gastos</option>
              <option value="both" selected>Comparativa</option>
            </select>
          </label>
        </div>
        <div class="chart-card__body" data-chart-daily>
          <div class="chart-placeholder" aria-busy="true"><span class="skeleton skeleton--block"></span></div>
        </div>
      </div>
    </section>

    <section class="charts-row charts-row--donuts" aria-labelledby="charts-donuts-title">
      <div class="chart-card">
        <div class="chart-card__header">
          <div>
            <h2 id="chart-channel-title" class="chart-card__title">Ventas por Canal</h2>
            <p class="chart-card__subtitle">Rendimiento por punto de contacto</p>
          </div>
          <span class="chart-card__icon" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21.21 15.89A10 10 0 1 1 2.79 2.79"></path><path d="M22 12A10 10 0 0 0 12 2"></path><path d="M12 2v10"></path><path d="M12 12a10 10 0 0 0 10 10"></path></svg>
          </span>
        </div>
        <div class="chart-card__body" data-chart-channel>
          <div class="chart-placeholder" aria-busy="true"><span class="skeleton skeleton--block"></span></div>
        </div>
      </div>

      <div class="chart-card">
        <div class="chart-card__header">
          <div>
            <h2 id="chart-shipment-title" class="chart-card__title">Métodos de Envío</h2>
            <p class="chart-card__subtitle">Distribución logística de entregas</p>
          </div>
          <span class="chart-card__icon" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>
          </span>
        </div>
        <div class="chart-card__body" data-chart-shipment>
          <div class="chart-placeholder" aria-busy="true"><span class="skeleton skeleton--block"></span></div>
        </div>
      </div>
    </section>

    <!--
      Trama diagonal de las barras: un `<pattern>` por serie, definido una vez y
      referenciado por CSS con `fill: url(#…)`. Va en un SVG oculto para que los
      gráficos puedan pintarse sin que el renderizador (que es puro) sepa nada de
      la textura.
    -->
    <svg class="chart-hatch-defs" width="0" height="0" aria-hidden="true" focusable="false">
      <defs>
        <pattern id="chart-hatch-income" width="6" height="6" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
          <rect width="6" height="6" fill="var(--m3-primary)"></rect>
          <line x1="0" y1="0" x2="0" y2="6" stroke="var(--chart-hatch)" stroke-width="1.6"></line>
        </pattern>
        <pattern id="chart-hatch-expense" width="6" height="6" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
          <rect width="6" height="6" fill="var(--m3-secondary)"></rect>
          <line x1="0" y1="0" x2="0" y2="6" stroke="var(--chart-hatch)" stroke-width="1.6"></line>
        </pattern>
      </defs>
    </svg>
  </div>
<style>
  .summary-page {
    display: grid;
    gap: var(--m3-space-xl);
    padding-inline: var(--m3-margin);
  }

  @media (max-width: 640px) {
    .summary-page {
      padding-inline: var(--m3-margin-mobile);
    }
  }

  /* El título se alinea por arriba, como en el resto de las pantallas: con
     `flex-end` el bloque del título bajaba hasta el fondo del select de período,
     que es más alto, y el encabezado del resumen quedaba más abajo que el de
     ventas, paquetes o gastos. */
  .page-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .page-head > div {
    display: flex;
    flex-direction: column;
    gap: var(--m3-space-2);
  }

  .page-head h1 {
    margin: 0;
    font-size: var(--m3-fs-headline-xl);
    line-height: var(--m3-lh-headline-xl);
    letter-spacing: var(--m3-ls-headline-xl);
    font-weight: 600;
    color: var(--ink);
    display: flex;
    align-items: center;
    gap: var(--m3-space-sm);
  }

  .page-title-icon {
    flex-shrink: 0;
    color: var(--ink-2);
  }

  .filter-bar {
    border-bottom: 1px solid var(--border);
  }

  .charts-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--m3-space-lg);
  }

  .charts-row--daily .chart-card {
    grid-column: 1 / -1;
  }

  @media (min-width: 1080px) {
    .charts-row--donuts {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* El mismo aire y el mismo radio que las tarjetas de KPI (`.stat-card`): el
     contenido de los gráficos arranca en la misma línea que el de las cifras. */
  .chart-card {
    background: var(--m3-surface-container-lowest);
    border: 1px solid var(--m3-outline-variant);
    border-radius: var(--radius-lg);
    padding: 16px 20px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .chart-card__header {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    align-items: flex-start;
    justify-content: space-between;
  }

  .chart-card__header > div {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  @media (min-width: 640px) {
    .chart-card__header {
      flex-direction: row;
      align-items: center;
    }
  }

  .chart-card__title {
    font-size: 15px;
    font-weight: 600;
    color: var(--m3-on-surface);
    margin: 0;
  }

  .chart-card__subtitle {
    font-size: var(--m3-fs-label-sm, 12px);
    color: var(--m3-on-surface-variant);
    margin: 0;
  }

  .chart-card__icon {
    color: var(--m3-on-surface-variant);
    flex-shrink: 0;
  }

  .chart-view {
    display: inline-flex;
    align-items: center;
    gap: var(--m3-space-xs);
    font-size: var(--m3-fs-label-sm, 12px);
    color: var(--m3-on-surface-variant);
    flex-shrink: 0;
  }

  .chart-view__label {
    font-weight: 600;
    margin-right: 10px;
  }

  .chart-view__select {
    height: 2rem;
    padding-inline: var(--m3-space-sm);
    background: var(--m3-surface-container-low);
    color: var(--m3-on-surface);
    border: 1px solid transparent;
    border-radius: var(--radius-sm);
    font-family: inherit;
    font-size: var(--m3-fs-body-sm);
    line-height: var(--m3-lh-body-sm);
    cursor: pointer;
  }

  .chart-view__select:hover {
    background: var(--m3-surface-container);
  }

  .chart-view__select:focus-visible {
    border-color: var(--m3-primary);
    outline: 2px solid var(--m3-primary);
    outline-offset: 1px;
  }

  .chart-card__body {
    min-width: 0;
    min-height: 220px;
  }

  .chart-card__body[data-chart-daily] {
    min-height: 300px;
    overflow: hidden;
  }
</style>
