---
import "../styles/global.css"
import ThemeBoot from "../components/ThemeBoot.astro"
import { Eye, Lock, User, Download } from "lucide-astro"

const description = "Entrá al panel de ShopMar con tu usuario o correo."
---

<!--
  `/login` es un **documento propio**, no una vista de la SPA (T6). No lleva la
  barra lateral, ni la barra inferior, ni el cajón: esas piezas son la navegación
  de un panel que todavía no se abrió, y la misma razón deja fuera del router a
  `/offline` y al 404 (D-023).

  La pantalla sigue la referencia de login oscuro del proyecto: columna centrada,
  logo arriba, título grande, campos rellenos con su ícono adentro y un botón
  ancho. Sin tarjeta: el fondo hace de superficie.

  El formulario no trae «recordarme» a propósito: la sesión no vence, solo se
  cierra con el botón de cerrar sesión.
-->
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <title>Iniciar sesión · ShopMar</title>
    <meta name="theme-color" content="#f1f1f2" />
    <!--
      El manifiesto y las metas de iOS viajan también acá, no sólo en el armazón:
      sin `manifest` el navegador no considera instalable esta pantalla y
      `beforeinstallprompt` nunca llega, así que el botón «Instalar aplicación»
      no tendría nada que ofrecer. Quien todavía no entró es justamente quien más
      lo necesita.
    -->
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="ShopMar" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <ThemeBoot />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
    />
  </head>
  <body class="login-body">
    <main class="login-main" data-page="login">
      <div class="login-shell">
        <!--
          El tema, antes de entrar. `ThemeBoot` ya puso `data-theme` en el
          `<html>` sin que el documento parpadee; este botón lo cambia y lo
          guarda en `localStorage`, con el mismo módulo del armazón
          (`lib/shell/theme-toggle.ts`). El ícono y el texto muestran el modo en
          el que se está, igual que en la barra lateral.
        -->
        <div class="login-topbar">
          <button
            type="button"
            class="login-theme"
            data-theme-toggle
            aria-label="Cambiar tema"
            aria-pressed="false"
            title="Cambiar tema"
          >
            <svg class="login-theme-icon login-theme-icon--light" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>
            <svg class="login-theme-icon login-theme-icon--dark" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="5"></circle><line x1="12" y1="1" x2="12" y2="3"></line><line x1="12" y1="21" x2="12" y2="23"></line><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line><line x1="1" y1="12" x2="3" y2="12"></line><line x1="21" y1="12" x2="23" y2="12"></line><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line></svg>
            <span class="login-theme-label login-theme-label--light">Modo claro</span>
            <span class="login-theme-label login-theme-label--dark">Modo oscuro</span>
          </button>
        </div>

        <!-- El logo del proyecto, el mismo del favicon y de la barra lateral. -->
        <header class="login-brand">
          <img class="login-logo" src="/favicon.svg" alt="" width="56" height="56" />
          <span class="login-name">ShopMar</span>
          <span class="login-tagline">Ventas, gastos y envíos</span>
        </header>

        <h1 class="login-title">Iniciar sesión</h1>
        <p class="login-lead">Hola de nuevo. Entrá con tu usuario o tu correo.</p>

        <form class="login-form" data-login-form novalidate>
          <div class="login-field">
            <label class="login-label login-label--hidden" for="login-identifier">
              Usuario o correo
            </label>
            <span class="login-control">
              <User class="login-icon" size={18} aria-hidden="true" />
              <input
                class="login-input"
                id="login-identifier"
                name="identifier"
                type="text"
                placeholder="Usuario o correo"
                autocomplete="username"
                autocapitalize="none"
                spellcheck="false"
                required
                data-login-identifier
              />
            </span>
          </div>

          <div class="login-field">
            <label class="login-label login-label--hidden" for="login-password">Contraseña</label>
            <span class="login-control">
              <Lock class="login-icon" size={18} aria-hidden="true" />
              <input
                class="login-input"
                id="login-password"
                name="password"
                type="password"
                placeholder="Contraseña"
                autocomplete="current-password"
                required
                data-login-password
              />
              <button
                class="login-reveal"
                type="button"
                aria-label="Mostrar la contraseña"
                aria-pressed="false"
                data-login-reveal
              >
                <Eye size={18} aria-hidden="true" />
              </button>
            </span>
          </div>

          <p class="login-error" data-login-error role="alert" hidden></p>

          <button class="btn btn-primary login-submit" type="submit" data-login-submit>
            Entrar
          </button>
        </form>

        <p class="login-foot">
          ¿No tenés cuenta? Pedile a un administrador que te dé acceso: las cuentas no se crean
          desde acá.
        </p>

        <!--
          Instalar la aplicación antes de entrar. El bloque lo prende
          `initInstallPrompt` según lo que el navegador ofrezca: el botón cuando el
          navegador puede instalar, la indicación de Compartir en iPhone y iPad, y
          nada si ya está instalada o si el navegador no lo soporta. Es el mismo
          mecanismo del armazón (`lib/shell/install-prompt.ts`), con el marcado
          `data-install-*` que ese módulo busca.
        -->
        <div class="login-install" data-install-block hidden>
          <button type="button" class="login-install-action" data-install-button hidden>
            <Download size={16} aria-hidden="true" />
            <span>Instalar aplicación</span>
          </button>
          <p class="login-install-hint" data-install-hint hidden>
            En iPhone o iPad: abrí Compartir y elegí «Añadir a pantalla de inicio».
          </p>
        </div>
      </div>
    </main>
  </body>
</html>

<script>
  import { ApiError } from "../lib/core/api"
  import { clearCache } from "../lib/core/cache"
  import { safeLocalStorage } from "../lib/core/storage"
  import { onPageLoad } from "../lib/core/page-load"
  import { loginUser } from "../lib/auth/auth-api"
  import { initPasswordVisibility } from "../lib/auth/password-visibility"
  import { initInstallPrompt } from "../lib/shell/install-prompt"
  import { initPwa } from "../lib/shell/pwa"
  import { initThemeToggle } from "../lib/shell/theme-toggle"
  import {
    loginErrorMessage,
    readNext,
    validateLoginForm,
    type ILoginErrorLike,
  } from "../lib/auth/login"
  import { writeMe } from "../lib/auth/session"

  /**
   * La pantalla de login (T6). Todo lo que se puede decidir sin DOM está en
   * `lib/auth/login.ts`; acá solo se lee el formulario, se pide el login y se
   * pinta la respuesta.
   */
  onPageLoad("login", () => {
    // Lo que en el armazón vive en la barra lateral y acá tiene que existir
    // igual: cambiar el tema antes de entrar (el tema se guarda en
    // `localStorage`, así que el panel abre con el que se eligió acá), instalar
    // la aplicación y registrar el service worker, que es lo que la vuelve
    // instalable. Los tres módulos son los mismos del armazón.
    initThemeToggle()
    initInstallPrompt()
    initPwa()
  })

  onPageLoad("login", () => {
    const form = document.querySelector<HTMLFormElement>("[data-login-form]")
    const identifier = document.querySelector<HTMLInputElement>("[data-login-identifier]")
    const password = document.querySelector<HTMLInputElement>("[data-login-password]")
    const submit = document.querySelector<HTMLButtonElement>("[data-login-submit]")
    const errorBox = document.querySelector<HTMLElement>("[data-login-error]")
    if (form === null || identifier === null || password === null || submit === null) return

    // Alias ya no nulos: las clausuras de abajo se crean después del chequeo,
    // pero el compilador no conserva el estrechamiento adentro de ellas.
    const loginForm: HTMLFormElement = form
    const identifierInput: HTMLInputElement = identifier
    const passwordInput: HTMLInputElement = password
    const submitButton: HTMLButtonElement = submit

    // El ojo del campo de contraseña: muestra lo escrito para encontrar un
    // error de tipeo sin borrar nada (en el teléfono el teclado tapa la mitad).
    const visibility = initPasswordVisibility(
      document.querySelector<HTMLElement>("[data-login-reveal]"),
      passwordInput,
    )

    // El envío queda deshabilitado mientras hay un pedido: el doble toque no
    // puede contar como dos intentos del límite de 10 por minuto.
    let pending = false

    function showError(message: string): void {
      if (errorBox === null) return
      errorBox.textContent = message
      errorBox.removeAttribute("hidden")
    }

    function hideError(): void {
      if (errorBox === null) return
      errorBox.textContent = ""
      errorBox.setAttribute("hidden", "")
    }

    function setPending(value: boolean): void {
      pending = value
      submitButton.disabled = value
      submitButton.setAttribute("aria-busy", value ? "true" : "false")
      loginForm.setAttribute("aria-busy", value ? "true" : "false")
    }

    function asLoginError(error: unknown): ILoginErrorLike {
      if (error instanceof ApiError) return { code: error.code, status: error.status }
      return { code: "INTERNAL_ERROR", status: 500 }
    }

    loginForm.addEventListener("submit", (event) => {
      event.preventDefault()
      if (pending) return

      // Al enviar, la contraseña vuelve a ocultarse: no queda a la vista.
      visibility.hide()

      const user = identifierInput.value.trim()
      const secret = passwordInput.value
      const invalid = validateLoginForm(user, secret)
      if (invalid !== null) {
        showError(invalid)
        if (user === "") identifierInput.focus()
        else passwordInput.focus()
        return
      }

      void (async () => {
        hideError()
        setPending(true)
        try {
          const me = await loginUser(user, secret)
          // Los datos cacheados no pueden sobrevivir a un cambio de sesión.
          clearCache()
          // El login devuelve el mismo `user` que el `me`: es la copia que el
          // panel usa para pintar el rol mientras el guard revalida detrás.
          writeMe(safeLocalStorage(), me)
          // `replace` para que el botón atrás no vuelva al formulario.
          window.location.replace(readNext(window.location.search))
        } catch (error) {
          showError(loginErrorMessage(asLoginError(error)))
          setPending(false)
        }
      })()
    })

    identifierInput.focus()
  })
</script>

<style>
  /*
    La pantalla imita la referencia de login oscuro del proyecto: fondo casi
    negro con un halo arriba y una grilla apenas visible, el logo arriba, título
    grande, campos rellenos con el ícono adentro y un botón ancho. Los colores
    son los del sistema, así que el modo claro invierte todo sin reglas propias.
  */
  .login-body {
    min-block-size: 100dvh;
    margin: 0;
    background-color: var(--m3-surface);
    background-image:
      radial-gradient(
        120% 70% at 50% 0%,
        color-mix(in srgb, var(--m3-primary) 10%, transparent) 0%,
        transparent 62%
      ),
      linear-gradient(var(--line) 1px, transparent 1px),
      linear-gradient(90deg, var(--line) 1px, transparent 1px);
    background-size:
      100% 100%,
      64px 64px,
      64px 64px;
    color: var(--m3-on-surface);
    font-family: var(--font-sans);
  }

  .login-main {
    display: flex;
    align-items: center;
    justify-content: center;
    min-block-size: 100dvh;
    padding: var(--m3-space-lg) var(--m3-margin);
    padding-block-start: max(var(--m3-space-lg), var(--safe-top));
    padding-block-end: max(var(--m3-space-lg), var(--safe-bottom));
  }

  .login-shell {
    display: flex;
    flex-direction: column;
    inline-size: 100%;
    max-inline-size: 22.5rem;
  }

  .login-brand {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    margin-block-end: var(--m3-space-xl);
    text-align: center;
  }

  /*
    El botón del tema arriba y a la derecha del contenido: se ve sin bajar, y en
    el teléfono queda en el pulgar.
  */
  .login-topbar {
    display: flex;
    justify-content: flex-end;
    margin-block-end: var(--m3-space-md);
  }

  .login-theme {
    display: inline-flex;
    align-items: center;
    gap: var(--m3-space-xs);
    min-block-size: var(--touch-min);
    padding-inline: var(--m3-space-md);
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    background: var(--surface-inset);
    color: var(--ink-2);
    font: inherit;
    font-size: var(--m3-fs-label-sm);
    line-height: var(--m3-lh-label-sm);
    cursor: pointer;
    transition:
      color var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out),
      background-color var(--dur-fast) var(--ease-out);
  }

  .login-theme:hover {
    border-color: var(--m3-on-surface);
    background: var(--surface);
    color: var(--ink);
  }

  .login-theme:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  /* El ícono y el rótulo dicen en qué modo se está, como en la barra lateral. */
  .login-theme-icon--dark,
  .login-theme-label--dark {
    display: none;
  }

  :global([data-theme="dark"]) .login-theme-icon--light,
  :global([data-theme="dark"]) .login-theme-label--light {
    display: none;
  }

  :global([data-theme="dark"]) .login-theme-icon--dark {
    display: block;
  }

  :global([data-theme="dark"]) .login-theme-label--dark {
    display: inline;
  }

  .login-logo {
    inline-size: 56px;
    block-size: 56px;
    margin-block-end: var(--m3-space-sm);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-raised);
  }

  .login-name {
    font-size: var(--text-h3);
    line-height: 1.25;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: var(--ink);
  }

  .login-tagline {
    font-size: var(--m3-fs-label-sm);
    line-height: var(--m3-lh-label-sm);
    color: var(--ink-3);
  }

  .login-title {
    margin: 0;
    text-align: center;
    font-size: clamp(1.75rem, 6vw, 2.125rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
    font-weight: 700;
    color: var(--ink);
  }

  .login-lead {
    margin: var(--m3-space-sm) 0 var(--m3-space-xl);
    font-size: var(--m3-fs-body-sm);
    line-height: var(--m3-lh-body-sm);
    color: var(--m3-on-surface-variant);
    text-align: center;
  }

  .login-form {
    display: flex;
    flex-direction: column;
    gap: var(--m3-space-md);
  }

  .login-field {
    display: flex;
    flex-direction: column;
    gap: var(--m3-space-xs);
  }

  /* La etiqueta existe para el lector de pantalla y para el toque en el teléfono. */
  .login-label--hidden {
    position: absolute;
    inline-size: 1px;
    block-size: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  .login-control {
    display: flex;
    align-items: center;
    gap: var(--m3-space-sm);
    min-block-size: 3.25rem;
    padding-inline: var(--m3-space-md);
    border: 1px solid transparent;
    border-radius: var(--radius-md);
    background: var(--surface-inset);
    transition:
      border-color var(--dur-fast) var(--ease-out),
      background-color var(--dur-fast) var(--ease-out),
      box-shadow var(--dur-fast) var(--ease-out);
  }

  .login-control:focus-within {
    border-color: var(--m3-on-surface);
    background: var(--surface);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--m3-primary) 18%, transparent);
  }

  .login-icon {
    flex: none;
    color: var(--ink-3);
  }

  .login-control:focus-within .login-icon {
    color: var(--m3-on-surface);
  }

  .login-input {
    flex: 1;
    min-inline-size: 0;
    min-block-size: var(--touch-min);
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--ink);
    font: inherit;
    font-size: var(--text-body);
  }

  .login-input::placeholder {
    color: var(--ink-3);
  }

  .login-input:focus {
    outline: none;
  }

  /* El ojo: al toque, 44px; se ve solo el ícono. */
  .login-reveal {
    display: grid;
    place-items: center;
    flex: none;
    inline-size: var(--touch-min);
    block-size: var(--touch-min);
    margin-inline-end: calc(-1 * var(--m3-space-sm));
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--ink-3);
    cursor: pointer;
    border-radius: var(--radius-sm);
  }

  .login-reveal:hover,
  .login-reveal:focus-visible,
  .login-reveal[data-visible="true"] {
    color: var(--ink);
  }

  .login-error {
    margin: 0;
    padding: var(--m3-space-sm) var(--m3-space-md);
    border-radius: var(--radius-sm);
    background: var(--m3-error-container);
    color: var(--m3-on-error-container);
    font-size: var(--m3-fs-label-md);
    line-height: var(--m3-lh-label-md);
  }

  .login-submit {
    inline-size: 100%;
    min-block-size: 3.25rem;
    margin-block-start: var(--m3-space-xs);
    border-radius: var(--radius-pill);
    font-weight: 600;
  }

  .login-submit:disabled {
    opacity: 0.6;
    cursor: progress;
  }

  .login-foot {
    margin: var(--m3-space-xl) 0 0;
    font-size: var(--m3-fs-label-sm);
    line-height: var(--m3-lh-label-sm);
    color: var(--ink-3);
    text-align: center;
  }

  /*
    Instalar la aplicación: una acción secundaria, con el peso de un enlace y el
    blanco de toque de un botón. El bloque lo muestra `initInstallPrompt`; el
    `[hidden]` explícito es necesario porque `display: flex` gana sobre la regla
    del agente de usuario y el bloque quedaría siempre a la vista.
  */
  .login-install {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--m3-space-sm);
    margin-block-start: var(--m3-space-lg);
  }

  .login-install[hidden] {
    display: none;
  }

  .login-install-action {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--m3-space-sm);
    min-block-size: var(--touch-min);
    padding-inline: var(--m3-space-lg);
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    background: var(--surface-inset);
    color: var(--ink);
    font: inherit;
    font-size: var(--m3-fs-label-md);
    line-height: var(--m3-lh-label-md);
    font-weight: 600;
    cursor: pointer;
    transition:
      border-color var(--dur-fast) var(--ease-out),
      background-color var(--dur-fast) var(--ease-out);
  }

  .login-install-action[hidden] {
    display: none;
  }

  .login-install-action:hover {
    border-color: var(--m3-on-surface);
    background: var(--surface);
  }

  .login-install-hint {
    margin: 0;
    max-inline-size: 28ch;
    font-size: var(--m3-fs-label-sm);
    line-height: var(--m3-lh-label-sm);
    color: var(--ink-3);
    text-align: center;
  }

  /* En el teléfono el fondo ya es la superficie: sin halo grande ni grilla densa. */
  @media (max-width: 480px) {
    .login-body {
      background-size:
        100% 100%,
        48px 48px,
        48px 48px;
    }

    .login-brand {
      margin-block-end: var(--m3-space-lg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .login-control {
      transition: none;
    }
  }
</style>
