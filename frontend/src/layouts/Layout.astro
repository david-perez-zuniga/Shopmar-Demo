---
export interface Props {
  title?: string;
  description?: string;
}

const { title = 'ShopMar Demo', description = import.meta.env.PUBLIC_SITE_DESCRIPTION ?? 'Demo de ShopMar en Astro' } = Astro.props;
const siteUrl = import.meta.env.PUBLIC_SITE_URL ?? '';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={siteUrl} />
    <title>{title}</title>

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500;1,600;1,700&display=swap" rel="stylesheet" />

    <!-- CSS Tokens -->
    <link rel="stylesheet" href="/styles/variables.css" />
    <link rel="stylesheet" href="/styles/global.css" />
  </head>
  <body class="{ isDark: theme === 'dark' }">
    <!-- Nav -->
    <nav class="border-b bg-background/80 backdrop-blur dark:bg-dark/60">
      <div class="max-w-[calc(100%-1rem)] mx-auto flex items-center justify-between px-2 pb-2">
        <a href="/">
          <svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M12 6v6l4 2" /><path d="M12 18v6l-4 2" /><path d="M4.93 4.93l2.83 2.83m2.03 4.89l2.83-2.83m6.38 9.89l-2.83-2.83M6 12H4m16 0h-2m2 5h2m4-9v2m-4 7v2m8-3V9m-3-3V7m0 4v2m4-3v2M6 12c7.164 0 13-4.46 13-10A9.973 9.973 0 0 0 3.83 3a12.02 12.02 0 0 0-3.06 1.61l.44.44m12.73 0l.44.44m0 11.08a3 3 0 1 1-6.03 0l-.44-.44" /></svg>
        </a>

        <div class="flex items-center gap-4">
          <a href="/sales/new?type=whatsapp" class="btn-cta text-primary hover:text-primary-foreground transition-colors" data-tooltip="Venta en tienda" aria-label="Venta en tienda">
            Venta en tienda
          </a>
          <a href="/sales/new?type=live" class="btn-cta text-primary hover:text-primary-foreground transition-colors" data-tooltip="Venta por Live" aria-label="Venta por Live">
            Venta por Live
          </a>
        </div>

        <button 
          onclick="document.documentElement.dataset.theme = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark'"
          class="theme-toggle btn-ghost w-8 h-8 rounded-full bg-background/20 dark:bg-dark/20 flex items-center justify-center transition-colors"
          aria-label="Alternar modo claro/oscuro"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><circle cx="12" cy="12" r="5" /><line x1="12" y1="1" x2="12" y2="3" /><line x1="12" y1="21" x2="12.01" y2="21" /><line x1="4.22" y1="4.22" x2="5.64" y2="5.64" /><line x1="18.36" y1="18.36" x2="19.78" y2="19.78" /><line x1="1" y1="12" x2="3.23" y2="12" /><line x1="21" y1="12" x2="23.23" y2="12" /><line x1="4.22" y1="19.78" x2="5.64" y2="18.36" /><line x1="18.36" y1="5.64" x2="19.78" y2="4.22" /></svg>
          <svg class="w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" /><path d="M10.5 3h3v2h-3V3zM14 6h6v2h-6V6zM15 9h4v2h-4V9zM10 12h6v2h-6V12zM16 15h2v6h-2v-6zM9 18H5v-2h4v-3.21l4 4V18H9z" /></svg>
        </button>
      </div>
    </nav>

    <main>
      <slot />
    </main>

    <!-- Footer simple -->
    <footer class="border-t bg-background/80 backdrop-blur dark:bg-dark/60 py-4 text-center text-sm text-muted-foreground">
      <p>ShopMar Demo · Astro + TypeScript</p>
    </footer>
  </body>
</html>