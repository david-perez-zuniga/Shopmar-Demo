---
import Layout from '../layouts/Layout.astro';
---
<Layout title="ShopMar Demo - Inicio de Sesión">
  <div class="min-h-screen flex items-center justify-center bg-background dark:bg-dark">
    <div class="bg-card dark:bg-dark rounded-2xl w-full max-w-md p-8 shadow-2xl">
      <h2 class="text-3xl font-medium text-foreground text-center mb-6">Bienvenido de nuevo</h2>
      <form class="space-y-4">
        <div>
          <label class="block text-sm text-foreground mb-2">Correo electrónico</label>
          <input type="email" required class="w-full rounded-lg border border-border px-3 py-2 bg-background dark:bg-dark text-foreground placeholder-muted-foreground focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent" placeholder="ejemplo@shopmar.com" />
        </div>
        <div>
          <label class="block text-sm text-foreground mb-2">Contraseña</label>
          <input type="password" required class="w-full rounded-lg border border-border px-3 py-2 bg-background dark:bg-dark text-foreground placeholder-muted-foreground focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent" placeholder="••••••••" />
        </div>
        <button type="submit" class="w-full rounded-lg bg-primary py-2 px-4 text-primary-foreground font-medium hover:opacity-90 transition-opacity">
          Ingresar
        </button>
      </form>
      <p class="text-center text-sm text-muted-foreground mt-4">
        ¿No tienes cuenta? <a href="#" class="text-primary hover underline">Regístrate</a>
      </p>
    </div>
  </div>
</Layout>