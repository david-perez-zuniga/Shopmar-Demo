---
import { ShoppingCart } from 'lucide-astro';
---
<section class="grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-4">
  <div class="bg-card dark:bg-dark rounded-xl border border-border p-6">
    <div class="flex items-start justify-between gap-3">
      <div class="w-12 h-12 rounded-lg bg-background/50 dark:bg-dark/50 flex items-center justify-center">
        <ShoppingCart class="w-6 h-6 text-primary" />
      </div>
      <div>
        <p class="text-xs text-muted-foreground uppercase tracking-wider">Total Ventas</p>
        <p class="text-3xl font-medium">$12,345.67</p>
        <p class="text-xs text-muted-foreground">▲ 12.5%</p>
      </div>
    </div>
  </div>
</section>