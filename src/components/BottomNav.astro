---
---
<nav class="bottom-0 left-0 right-0 bg-background dark:bg-dark z-50 flex justify-between items-center px-4 py-2">
  <button 
    class="page-btn flex-1 rounded-lg bg-transparent border border-border px-3 py-2 text-sm text-foreground hover:bg-accent hover:text-accent-foreground transition-colors"
    data-link="/"
    aria-label="Home"
  >
    Home
  </button>
  <button 
    class="page-btn flex-1 rounded-lg bg-transparent border border-border px-3 py-2 text-sm text-foreground hover:bg-accent hover:text-accent-foreground transition-colors"
    data-link="/sales"
    aria-label="Sales"
  >
    Sales
  </button>
  <button 
    class="page-btn flex-1 rounded-lg bg-transparent border border-border px-3 py-2 text-sm text-foreground hover:bg-accent hover:text-accent-foreground transition-colors"
    data-link="/packages"
    aria-label="Packages"
  >
    Packages
  </button>
  <button 
    class="page-btn flex-1 rounded-lg bg-transparent border border-border px-3 py-2 text-sm text-foreground hover:bg-accent hover:text-accent-foreground transition-colors"
    data-link="/expenses"
    aria-label="Expenses"
  >
    Expenses
  </button>
  <button 
    class="page-btn flex-1 rounded-lg bg-transparent border border-border px-3 py-2 text-sm text-foreground hover:bg-accent hover:text-accent-foreground transition-colors"
    data-link="/customers"
    aria-label="Customers"
  >
    Customers
  </button>
  <button 
    onclick="document.documentElement.dataset.theme = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark'"
    class="w-8 h-8 rounded-full bg-background/20 dark:bg-dark/20 flex items-center justify-center"
    aria-label="Alternar modo claro/oscuro"
  >
    <svg 
      class="w-5 h-5" 
      fill="none"
      stroke="currentColor"
      viewBox="0 0 24 24"
    >
      <circle cx="12" cy="12" r="5" />
      <line x1="12" y1="1" x2="12" y2="3" />
      <line x1="12" y1="21" x2="12.01" y2="21" />
      <line x1="4.22" y1="4.22" x2="5.64" y2="5.64" />
      <line x1="18.36" y1="18.36" x2="19.78" y2="19.78" />
      <line x1="1" y1="12" x2="3.23" y2="12" />
      <line x1="21" y1="12" x2="23.23" y2="12" />
      <line x1="4.22" y1="19.78" x2="5.64" y2="18.36" />
      <line x1="18.36" y1="5.64" x2="19.78" y2="4.22" />
    </svg>
    <svg 
      class="w-5 h-5 hidden" 
      fill="none"
      stroke="currentColor"
      viewBox="0 0 24 24"
    >
      <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
      <path d="M10.5 3h3v2h-3V3zM14 6h6v2h-6V6zM15 9h4v2h-4V9zM10 12h6v2h-6V12zM16 15h2v6h-2v-6zM9 18H5v-2h4v-3.21l4 4V18H9z" />
    </svg>
  </button>
</nav>

<script>
  // Resaltar botón activo basado en la ruta actual
  document.addEventListener('astro:after-layout-ready', () => {
    const currentPath = window.location.pathname
    document.querySelectorAll('.page-btn').forEach(btn => {
      btn.classList.remove('page-btn--current')
      if (btn.getAttribute('data-link') === '/' && currentPath === '/' || 
          btn.getAttribute('data-link').includes(currentPath.replace('/', ''))) {
        btn.classList.add('page-btn--current')
      }
    })
  })
</script>

<style>
  .page-btn--current {
    bg-accent;
    text-accent-foreground;
  }
  @media (prefers-reduced-motion: reduce) {
    .page-btn:hover { transition: none; }
  }
</style>