<button class="btn-print" onclick="window.print()">Imprimir</button>
<style>
  @media print {
    .print-header {
      text-align: center;
      margin-bottom: 1rem;
      padding-bottom: 0.5rem;
      border-bottom: 2px solid var(--border);
    }
    .print-table {
      width: 100%;
      border-collapse: collapse;
    }
    .print-table th,
    .print-table td {
      border: 1px solid var(--border);
      padding: 0.5rem;
      font-size: 0.875rem;
    }
    .print-total {
      text-align: right;
      margin-top: 1rem;
      font-weight: bold;
    }
  }
</style>