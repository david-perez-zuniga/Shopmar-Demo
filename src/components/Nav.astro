---
import ShoppingCart from 'lucide-astro/ShoppingCart'
import { navigateTo } from '@astrojs/navigation'
---

<nav class="border-b bg-background/80 backdrop-blur dark:bg-dark/60">
  <div class="max-w-[calc(100%-1rem)] mx-auto flex items-center justify-between px-2 pb-2">
    <a href="/">
      <ShoppingCart class="w-6 h-6 text-primary" />
    </a>

    <div class="flex items-center gap-4">
      <a 
        href="/sales/new?type=whatsapp" 
        class="btn-cta text-primary hover:text-primary-foreground transition-colors"
        data-tooltip="Venta en tienda"
        aria-label="Venta en tienda"
      >
        Venta en tienda
      </a>
      <a 
        href="/sales/new?type=live" 
        class="btn-cta text-primary hover:text-primary-foreground transition-colors"
        data-tooltip="Venta por Live"
        aria-label="Venta por Live"
      >
        Venta por Live
      </a>
      <a href="/packages" class="text-muted-foreground hover:text-primary transition-colors" data-tooltip="Ver paquetes" aria-label="Ver paquetes">
        Paquetes
      </a>
      <a href="/expenses" class="text-muted-foreground hover:text-primary transition-colors" data-tooltip="Ver gastos" aria-label="Ver gastos">
        Gastos
      </a>
      <a href="/customers" class="text-muted-foreground hover:text-primary transition-colors" data-tooltip="Ver clientes" aria-label="Ver clientes">
        Clientes
      </a>
    </div>

    <button 
      onclick="document.documentElement.dataset.theme = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark'"
      class="theme-toggle btn-ghost w-8 h-8 rounded-full bg-background/20 dark:bg-dark/20 flex items-center justify-center transition-colors"
      aria-label="Alternar modo claro/oscuro"
    >
      <svg 
        class="w-5 h-5" 
        id="sun-icon"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
      >
        <circle cx="12" cy="12" r="5" />
        <line x1="12" y1="1" x2="12" y2="3" />
        <line x1="12" y1="21" x2="12.01" y2="21" />
        <line x1="4.22" y1="4.22" x2="5.64" y2="5.64" />
        <line x1="18.36" y1="18.36" x2="19.78" y2="19.78" />
        <line x1="1" y1="12" x2="3.23" y2="12" />
        <line x1="21" y1="12" x2="23.23" y2="12" />
        <line x1="4.22" y1="19.78" x2="5.64" y2="18.36" />
        <line x1="18.36" y1="5.64" x2="19.78" y2="4.22" />
      </svg>
      <svg 
        class="w-5 h-5 hidden" 
        id="moon-icon"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
      >
        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
        <path d="M10.5 3h3v2h-3V3zM14 6h6v2h-6V6zM15 9h4v2h-4V9zM10 12h6v2h-6V12zM16 15h2v6h-2v-6zM9 18H5v-2h4v-3.21l4 4V18H9z" />
      </svg>
    </button>
  </div>
</nav>

<script>
  // Toggle theme on click
  const themeToggle = document.querySelector('button[data-theme-toggle]') || document.querySelector('button.theme-toggle')
  if (themeToggle) {
    themeToggle.addEventListener('click', () => {
      const html = document.documentElement
      const currentTheme = html.dataset.theme
      html.dataset.theme = currentTheme === 'dark' ? 'light' : 'dark'
      // Persistir en localStorage
      localStorage.setItem('shopmar-theme', currentTheme === 'dark' ? 'light' : 'dark')
    })
  }
</script>