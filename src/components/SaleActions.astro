---
const { onViewDetail, onChangeStatus, onPrint } = $props()
---
<div class="flex gap-2">
  <button 
    class="btn-action rounded-lg p-1.5 hover:bg-accent/10 dark:hover:bg-dark/20 transition-colors"
    aria-label="Ver detalle"
    data-tooltip="Ver detalle de la venta"
    onclick={onViewDetail}
  >
    <svg class="w-4 h-4 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path d="M18 6L6 18M6 6l12 12" />
    </svg>
  </button>
  <button 
    class="btn-action rounded-lg p-1.5 hover:bg-accent/10 dark:hover:bg-dark/20 transition-colors"
    aria-label="Cambiar estado"
    data-tooltip="Cambiar estado de la venta"
    onclick={onChangeStatus}
  >
    <svg class="w-4 h-4 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7" />
      <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z" />
    </svg>
  </button>
  <button 
    class="btn-action rounded-lg p-1.5 hover:bg-accent/10 dark:hover:bg-dark/20 transition-colors"
    aria-label="Imprimir"
    data-tooltip="Imprimir factura"
    onclick={onPrint}
  >
    <svg class="w-4 h-4 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path d="M14 2H6a2 2 0 0 0-2 2v2a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2v-2m-6 4a2 2 0 1 1-4 0 2 2 0 0 1 4 0zm7.5-4.5a2.4 2.4 0 1 1 0 4.8 2.4 2.4 0 0 1 0-4.8zm-2 .5a2.121 2.121 0 0 1-3 3L9 15l1.5 1.5" />
    </svg>
  </button>
</div>