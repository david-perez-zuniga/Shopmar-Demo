---
const { onStatusChange } = $props()
---
<tr class="border-b transition-colors hover:bg-background/50 dark:hover:bg-dark/50">
  <td class="p-4 text-sm font-medium">{{ date }}</td>
  <td class="p-4">{{ clientName }}</td>
  <td class="p-4">{{ merchandise }}</td>
  <td class="p-4">
    <span class="pill pill--{{ channel }}">{{ channel === 'whatsapp' ? 'Tienda' : 'Live' }}</span>
  </td>
  <td class="p-4">
    <select 
      class="select select-sm bg-background dark:bg-dark text-foreground rounded border border-border focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent"
      onChange={(e) => onStatusChange(e.target, {{ sale }})}
    >
      <option value="pending" {{#if eq status 'pending'}}selected{{/if}}>Pendiente</option>
      <option value="completed" {{#if eq status 'completed'}}selected{{/if}}>Completada</option>
      <option value="cancelled" {{#if eq status 'cancelled'}}selected{{/if}}>Cancelada</option>
    </select>
  </td>
  <td class="p-4">
    <div class="flex gap-2">
      <button class="btn-action p-1 hover:bg-accent/10 dark:hover:bg-dark/20 transition-colors" aria-label="Ver detalle">
        <svg class="w-3 h-3 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M18 6L6 18M6 6l12 12" /></svg>
      </button>
      <button class="btn-action p-1 hover:bg-accent/10 dark:hover:bg-dark/20 transition-colors" aria-label="Cambiar estado">
        <svg class="w-3 h-3 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7" /></svg>
      </button>
      <button class="btn-action p-1 hover:bg-accent/10 dark:hover:bg-dark/20 transition-colors" aria-label="Imprimir">
        <svg class="w-3 h-3 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v2a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2v-2" /></svg>
      </button>
    </div>
  </td>
</tr>